# GitHub Token for the Daily RSS Scraper (Required if running locally)
# Needs `repo` access if uploading to private repository releases.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# (Optional) Google Application Credentials for IndexNow/SEO Ping
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
